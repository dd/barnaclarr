# Copy to deploy/.env and adjust. deploy/.env is ignored by Git.

# Image tag from ghcr.io/dd/barnaclarr: a release such as 0.1.0, or dev.
IMAGE_TAG=latest

# Host dataset holding BOTH downloads and the media library. Hardlinks require
# one bind mount of one dataset: never mount downloads and library separately.
MEDIA_PATH=/mnt/tank/media

# Host directory for the SQLite queue/journal and lock (read-write, keep across upgrades).
STATE_PATH=/mnt/tank/apps/barnaclarr/state

# Optional host directory with config.toml for rules and mappings (mounted read-only).
CONFIG_PATH=/mnt/tank/apps/barnaclarr/config

# Host port for the Sonarr webhook.
WEBHOOK_PORT=8787

# Container user; TrueNAS apps conventionally run as 568:568.
PUID=568
PGID=568

# Container time zone for log timestamps, e.g. Europe/Berlin.
TZ=UTC

# Application settings. Paths are as seen inside the container (/mnt/media).
# Lists are comma-separated, or a JSON array if a path contains a comma.
BARNACLARR_DOWNLOAD_ROOTS=/mnt/media/downloads/anime
BARNACLARR_LIBRARY_ROOTS=/mnt/media/anime
BARNACLARR_FONT_ROOT=/mnt/media/.barnaclarr-fonts
BARNACLARR_SONARR_URL=http://host.docker.internal:8989
BARNACLARR_SONARR_API_KEY=
# Optional Radarr (movies); leave empty if you only use Sonarr, or vice versa.
BARNACLARR_RADARR_URL=
BARNACLARR_RADARR_API_KEY=
BARNACLARR_WEBHOOK_TOKEN=
BARNACLARR_DEFAULT_LANGUAGE=und
BARNACLARR_DRY_RUN=true
